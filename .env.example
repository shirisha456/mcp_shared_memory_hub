# Copy to .env for local development. Every setting is declared in src/memhub/config.py.
# The .env file itself is gitignored and must never be committed.

# Host port 5435 matches docker-compose.yml, which avoids clashing with a
# locally installed PostgreSQL on 5432.
MEMHUB_DATABASE_URL=postgresql+asyncpg://memhub:memhub@localhost:5435/memhub

MEMHUB_ENVIRONMENT=local

# Connection pool. Milestone 2's 50-way concurrency test raises pool_size for
# its own engine; a test claiming N-way concurrency against a smaller pool would
# measure sequential waves instead.
MEMHUB_DB_POOL_SIZE=10
MEMHUB_DB_MAX_OVERFLOW=5

# Bounded on purpose: unbounded queueing on an exhausted pool turns a slow
# backend into an unbounded latency tail.
MEMHUB_DB_POOL_TIMEOUT_S=2.0

# Enforced server-side so PostgreSQL kills a runaway query rather than the
# application merely abandoning it.
MEMHUB_DB_STATEMENT_TIMEOUT_MS=5000

MEMHUB_DB_ECHO=false

MEMHUB_LOG_LEVEL=INFO
MEMHUB_LOG_FORMAT=json
